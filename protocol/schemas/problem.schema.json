{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yancuo.local/schemas/workspace-problem-metadata-v1.json",
  "title": "Yancuo workspace problem metadata",
  "type": "object",
  "required": ["id", "revision"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string" },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "title": { "type": ["string", "null"] },
    "subject_name": { "type": ["string", "null"] },
    "chapter_name": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "content_blocks": {
      "type": "array",
      "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["text", "formula", "table", "figure"]}, "content": {"type": "string"}, "rows": {"type": "array", "maxItems": 100, "items": {"type": "array", "maxItems": 50, "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["content"], "properties": {"content": {"type": "string"}, "rowspan": {"type": "integer", "minimum": 1, "maximum": 100}, "colspan": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false}]}}}, "source_image_index": {"type": "integer", "minimum": 0}, "source_region": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}, "source_asset_id": {"type": "string"}, "derived_asset_id": {"type": "string"}}, "additionalProperties": true}
    },
    "asset_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "filename"],
        "properties": {
          "role": { "type": "string" },
          "filename": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
