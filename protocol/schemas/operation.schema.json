{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yancuo.local/protocol/schemas/operation.schema.json",
  "title": "Yancuo Operation v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "format_version",
    "operation_id",
    "device_id",
    "database_id",
    "timestamp",
    "entity_type",
    "entity_id",
    "operation",
    "changed_fields"
  ],
  "properties": {
    "format": { "const": "yancuo-operation" },
    "format_version": { "const": 1 },
    "operation_id": { "type": "string", "pattern": "^op_" },
    "device_id": { "type": "string", "minLength": 1 },
    "database_id": { "type": "string" },
    "timestamp": { "type": "string", "minLength": 1 },
    "entity_type": {
      "type": "string",
      "enum": ["problem", "tag", "asset", "review"]
    },
    "entity_id": { "type": "string", "minLength": 1 },
    "operation": {
      "type": "string",
      "enum": ["create", "update", "delete", "undelete"]
    },
    "base_revision": { "type": "integer", "minimum": 0 },
    "new_revision": { "type": "integer", "minimum": 0 },
    "changed_fields": { "type": "object" },
    "tombstone": { "type": "boolean" },
    "attachments": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["id", "role", "sha256", "content_base64"], "properties": {"id": {"type": "string", "pattern": "^asset_"}, "role": {"const": "derived_figure"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mime_type": {"type": ["string", "null"]}, "size_bytes": {"type": ["integer", "null"], "minimum": 0}, "width": {"type": ["integer", "null"], "minimum": 1}, "height": {"type": ["integer", "null"], "minimum": 1}, "content_base64": {"type": "string", "maxLength": 50331648}}, "additionalProperties": false}},
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    }
  }
}
